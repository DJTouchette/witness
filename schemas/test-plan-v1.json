{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Witness non-executing test plan v1",
  "type": "object",
  "required": ["schema_version", "root", "status", "coverage", "selection", "commands", "diagnostics"],
  "properties": {
    "schema_version": {"const": 1},
    "root": {"type": "string"},
    "status": {"enum": ["ready", "incomplete", "no_changes", "no_tests"]},
    "coverage": {"enum": ["selection", "suites", "unknown"]},
    "selection": {"type": ["object", "null"]},
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["argv", "cwd", "language"],
        "properties": {
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "cwd": {"type": "string", "minLength": 1},
          "language": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    },
    "diagnostics": {"type": "array", "items": {"type": "string"}}
  }
}
